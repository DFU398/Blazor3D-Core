        //     "https://threejs.org/examples/models/gltf/DamagedHelmet/glTF/DamagedHelmet.gltf",
        //     null,
        //     Guid.NewGuid());
        // await View3D1.SetCameraPositionAsync(new Vector3(0, 1, 5));
    }

    private async Task OnLoadPcdButtonClick()
    {
        await View3D1.Import3DModelAsync(
            new ImportSettings
            {
                Format = Import3DFormats.Pcd,
                FileURL = "https://threejs.org/examples/models/pcd/binary/Zaghetto.pcd",
                Material = new PointsMaterial() // It's important to set the right kind of material when importing a point cloud, else the points won't be visible
                {
                    Size = 0.0005
                }
            }
        );
    }

}

